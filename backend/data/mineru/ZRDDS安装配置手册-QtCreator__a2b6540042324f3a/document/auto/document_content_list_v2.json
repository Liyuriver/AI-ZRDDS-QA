        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup></sup> 预编译符：在.pro 文件中键入 DEFINES += _ZRDDSCPPINTERFACE。使用 ZRDDS 的 C++库时需要添加这个预编译符。"
                    }
                ]
            },
            "bbox": [
                181,
                181,
                850,
                216
            ]
        },
        {
            "type": "algorithm",
            "content": {
                "algorithm_caption": [
                    {
                        "type": "text",
                        "content": "图 4 预编译符"
                    }
                ],
                "algorithm_content": [
                    {
                        "type": "text",
                        "content": "DEFINES +=ZRDDSCPPINTERFACE"
                    }
                ],
                "algorithm_footnote": []
            },
            "bbox": [
                326,
                222,
                741,
                249
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "<sup></sup> 编译设置：若出现 not permitted with -fno-rtti 问题，在.pro 文件中键入 CONFIG += rtti。"
                    }
                ]
            },
            "bbox": [
                181,
                293,
                857,
                310
            ]
        },
        {
            "type": "image",
            "content": {
                "image_source": {
                    "path": "images/35e0bef8a1321b72d04322f27bb40caa632c08b8895b49c9fcbfd21f1160df9e.jpg"
                },
                "image_caption": [
                    {
                        "type": "text",
                        "content": "图 5 编译设置 rtti"
                    }
                ],
                "image_footnote": []
            },
            "bbox": [
                391,
                313,
                673,
                343
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "至此，Windows下qt环境ZRDDS项目配置完成，以C++为例，图 6为具体配置示例。"
                    }
                ]
            },
            "bbox": [
                183,
                386,
                838,
                403
            ]
        },
        {
            "type": "algorithm",
            "content": {
                "algorithm_caption": [
                    {
                        "type": "text",
                        "content": "图 6 pro 配置"
                    }
                ],
                "algorithm_content": [
                    {
                        "type": "text",
                        "content": "QT += core QT -= gui TARGET = DDSApp CONFIG += console 6CONFIG -= app bundle CONFIG G += rtti TEMPLATE = app SOURCES +=\\ Charseq.cpp\\ Charseq_publication.cpp CharSeqTypeSupport.cpp HEADERS += CharSeq.h\\ CharSegDataReader.h  CharSeqDataWriter.h \\ CharSeqTypeSupport.h INCLUDEPATH += $$quote($(ZRDDS HOME)\\include\\ZRDDSCoreInterface) $$quote($(ZRDDS HOME)\\include\\CPlusPlusInterface) LIBS += -L $$quote($(ZRDDS HOME)\\lib) -1zRDDSCppzd -1ws2 32 -1wsock32 -liphlpapi DEFINES += ZRDDSCPPINTERFACE TARGET = CharSeq_pub"
                    }
                ],
                "algorithm_footnote": []
            },
            "bbox": [
                184,
                411,
                845,
                653
            ]
        }
    ]
]